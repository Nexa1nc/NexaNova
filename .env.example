# API Keys per i motori di ricerca - COPIA E RINOMINA QUESTO FILE IN .env
# NON condividere mai il file .env!

# 1. DuckDuckGo (NO API KEY NEEDED - SEMPRE DISPONIBILE)
SEARCH_DUCKDUCKGO_ENABLED=true

# 2. Brave Search (OPZIONALE - Con API Key)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here
SEARCH_BRAVE_ENABLED=false

# 3. Tavily Search (OPZIONALE - Con API Key)
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_TAVILY_ENABLED=false

# 4. Searx (OPZIONALE - Self-hosted, no API)
SEARX_URL=https://searx.be
SEARCH_SEARX_ENABLED=true

# 5. Bing Search (OPZIONALE - Con API Key)
BING_SEARCH_API_KEY=your_bing_api_key_here
SEARCH_BING_ENABLED=false

# 6. Google Custom Search (OPZIONALE - Con API Key)
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your_engine_id_here
SEARCH_GOOGLE_ENABLED=false

# 7. Serper (ULTIMO FALLBACK - Con API Key)
SERPER_API_KEY=your_serper_api_key_here
SEARCH_SERPER_ENABLED=false
